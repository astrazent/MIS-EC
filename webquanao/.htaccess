RewriteEngine On
RewriteCond $1 !^(index\.php|resources|robots\.txt)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?$1 [L,QSA]

# Thiết lập biến môi trường CI_ENV
SetEnv CI_ENV development

# Bảo vệ file .env
<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>
SetEnv CI_ENV development